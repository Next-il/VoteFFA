<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace><cs2-vote></cs2-vote></RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CS2MenuManager">
      <HintPath>$(MSBuildThisFileDirectory)CS2MenuManager.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Next-il/Votes API, the build committed in lib/. Private=false: it must resolve from
         addons/counterstrikesharp/shared/VotesApi/, where the Votes release puts it. A copy beside this plugin
         gives it its own IVotesApi type and the capability lookup comes back empty. -->
    <Reference Include="VotesApi">
      <HintPath>$(MSBuildThisFileDirectory)lib\VotesApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.362" />
    <PackageReference Include="CS2MenuManager" Version="1.0.39" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
